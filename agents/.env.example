# `npm run setup` writes a real .env for you (git-ignored, mode 600). Never commit it.
# These optional settings can be added by hand:
# CONTRACT_ID=heto2-bybyte.testnet
# NEAR_RPC_URLS=https://rpc.testnet.near.org,https://test.rpc.fastnear.com
# DRY_RUN=true
# Real mode only (NEAR AI Cloud, OpenAI-compatible). Not used by tests or dry-run:
# NEAR_AI_BASE_URL=
# NEAR_AI_API_KEY=
# NEAR_AI_MODEL=
